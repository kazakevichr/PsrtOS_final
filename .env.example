DATABASE_URL="file:./dev.db"
NEXTAUTH_SECRET="replace-with-a-long-random-string"
NEXTAUTH_URL="http://localhost:3000"
OPENAI_API_KEY="replace-with-your-own-openai-api-key"
# Инста-аналитика и публикация (раздел «Инстаграм», /api/ig/host)
META_TOKEN="системный пользователь Meta с instagram_basic + insights"
META_IG_IDS="17841435633230475,17841480616527959,17841477388295027"
BRAND_MAP='{"superfit":["super.fit24","superfit24_woman","superfit24_training"]}'
IG_HOST_KEY="ключ загрузки картинок каруселей (X-Host-Key завода)"

# НЕОБЯЗАТЕЛЬНО. Заводов несколько (СуперФит, Оракл), но различать их
# настройкой не нужно: заказ относится к направлению по аккаунту, куда он
# опубликован, — по той же карте BRAND_MAP, что делит соцсети. Заводы могут
# ходить общим ключом IG_HOST_KEY, как и ходили.
#
# Переменная нужна лишь тогда, когда завод должен быть опознан ДО первой
# публикации — например, чтобы заказ в производстве сразу попал в свой
# журнал. Формат — пары «бренд:ключ» через запятую, без кавычек и скобок:
# значение вписывают руками в поле панели, а панели толкуют скобки по-своему.
FACTORY_KEYS=oracle:длинный-случайный-ключ-завода-оракла
