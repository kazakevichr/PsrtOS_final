NEXTAUTH_URL="http://localhost:3000"
OPENAI_API_KEY="replace-with-your-own-openai-api-key"
# Инста-аналитика и публикация (раздел «Инстаграм», /api/ig/host)
META_TOKEN="системный пользователь Meta с instagram_basic + insights"
META_IG_IDS="17841435633230475,17841480616527959,17841477388295027"
BRAND_MAP='{"superfit":["super.fit24","superfit24_woman","superfit24_training"]}'
IG_HOST_KEY="ключ загрузки картинок каруселей (X-Host-Key завода)"

# Второй контент-завод (Оракл). Заводов несколько: у каждого свой экземпляр,
# свои темы и свой журнал. Кто прислал отчёт, Постос узнаёт по ключу: основной
# IG_HOST_KEY — это СуперФит, остальные перечисляются здесь картой «ключ →
# бренд». Так завод подключается сменой одной переменной в ЕГО окружении
# (X-Factory-Key), без правки его кода.
# Бренд должен совпадать с тем, что стоит у направления в настройках проекта,
# блок «Контент» — по нему раздел показывает свой план и свой журнал.
# Формат — пары «бренд:ключ» через запятую, без кавычек и скобок: значение
# вписывают руками в поле панели, а панели толкуют скобки по-своему.
FACTORY_KEYS=oracle:длинный-случайный-ключ-завода-оракла
