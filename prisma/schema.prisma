generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}
model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         String     @default("MANAGER")
  fixedSalary  Float    @default(15000)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())

  // Телеграм: chatId появляется после привязки профиля через бота,
  // tgLinkCode — одноразовый код в ссылке t.me/...?start=<code>.
  tgChatId     String?  @unique
  tgUsername   String?
  tgLinkCode   String?  @unique

  partners     Partner[]      @relation("ResponsibleUser")
  tasks        Task[]         @relation("AssignedUser")
  transactions Transaction[]  @relation("CreatedByUser")
  comments     Comment[]
  stageChanges StageHistory[]
  payrolls     PayrollRecord[]
}

model Project {
  id                       String   @id @default(cuid())
  name                     String
  currency                 String   @default("RUB")
  unitPrice                Float?
  partnerCommissionPercent Float    @default(50)
  ownerProfitPercent       Float    @default(50)
  kpiEnabled               Boolean  @default(true)
  kpiAmount                Float    @default(0)
  kpiTriggerStage          String   @default("Работает")
  bonusEnabled             Boolean  @default(false)
  bonusPercent             Float    @default(0)
  bonusThreshold           Float    @default(0)
  bonusMaxAmount           Float?
  bonusPeriodMonths        Int?
  partnerPlan              Int?
  funnelStages             String   @default("[\"Найдено\",\"Согласился\",\"Работает\",\"Есть продажи\",\"Неактивный\"]")
  healthGreenDays          Int      @default(7)
  healthYellowDays         Int      @default(29)
  isActive                 Boolean  @default(true)
  knowledgeBase            String   @default("")
  createdAt                DateTime @default(now())

  partnerTypes PartnerType[]
  partners     Partner[]
}

model PartnerType {
  id        String  @id @default(cuid())
  projectId String
  name      String
  kpiAmount Float
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  partners  Partner[]
}

model Partner {
  id                 String        @id @default(cuid())
  projectId          String
  partnerTypeId      String?
  name               String
  instagram          String?
  telegram           String?
  phone              String?
  responsibleUserId  String
  stage              String
    status             String        @default("ACTIVE")
  firstContactDate   DateTime?
  connectedDate      DateTime?
  firstSaleDate      DateTime?
  lastSaleDate       DateTime?
  kpiPaid            Boolean       @default(false)
  lostReason         String?
  lostAt             DateTime?
  retryReminderDate  DateTime?
  adCreativeUrl      String?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  project      Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  partnerType  PartnerType?   @relation(fields: [partnerTypeId], references: [id])
  responsible  User           @relation("ResponsibleUser", fields: [responsibleUserId], references: [id])
  transactions Transaction[]
  stageHistory StageHistory[]
  tasks        Task[]
  comments     Comment[]
}

model StageHistory {
  id            String   @id @default(cuid())
  partnerId     String
  fromStage     String?
  toStage       String
  changedByUserId String
  changedAt     DateTime @default(now())

  partner   Partner @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  changedBy User    @relation(fields: [changedByUserId], references: [id])
}

model Transaction {
  id                  String   @id @default(cuid())
  partnerId           String
  date                DateTime
  period              String   @default("day")
  revenueAmount       Float
  ownerProfitAmount   Float
  partnerPayoutAmount Float    @default(0)
  partnerPayoutPaid   Boolean  @default(false)
  note                String?
  createdByUserId     String
  createdAt           DateTime @default(now())

  partner   Partner @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  createdBy User    @relation("CreatedByUser", fields: [createdByUserId], references: [id])
}

model Task {
  id               String    @id @default(cuid())
  assignedToUserId String
  partnerId        String?
  title            String
  dueDate          DateTime?
  isDone           Boolean   @default(false)
  isAuto           Boolean   @default(false)
  createdAt        DateTime  @default(now())

  assignedTo User     @relation("AssignedUser", fields: [assignedToUserId], references: [id])
  partner    Partner? @relation(fields: [partnerId], references: [id], onDelete: Cascade)
}

model Comment {
  id        String   @id @default(cuid())
  partnerId String
  userId    String
  text      String
  createdAt DateTime @default(now())

  partner Partner @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id])
}

model PayrollRecord {
  id          String   @id @default(cuid())
  userId      String
  month       String
  fixedAmount Float
  kpiTotal    Float
  bonusTotal  Float
  totalAmount Float
  paidAt      DateTime?
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@unique([userId, month])
}

// ── Инста-аналитика (перенос из insta-hq/Netlify) ───────────────────────────
// Один аккаунт Instagram = одна строка. history и media — JSON-строки:
// SQLite не умеет Json-тип, а история нужна целиком и всегда читается разом.
model IgAccount {
  igId      String   @id
  username  String
  brand     String
  profile   String   @default("{}")
  history   String   @default("[]")
  media     String   @default("[]")
  updatedAt DateTime @updatedAt
}

// Временный публичный хостинг картинок для публикации каруселей:
// Graph API принимает изображения только по публичному URL. Instagram
// забирает копию себе, наша живёт три дня и подчищается при загрузках.
model HostedImage {
  id        String   @id
  mime      String   @default("image/png")
  data      Bytes
  createdAt DateTime @default(now())
}

// ── Аналитика Оракла: YouTube-каналы (свои OAuth-токены завода) и TikTok
// (через upload-post Analytics). Паттерн тот же, что у IgAccount.
model OracleChannel {
  id        String   @id @default(cuid())
  platform  String // yt | tiktok
  key       String // язык канала (ru/en/...) или профиль upload-post
  profile   String   @default("{}")
  history   String   @default("[]")
  media     String   @default("[]")
  updatedAt DateTime @updatedAt

  @@unique([platform, key])
}

// ── Контент-завод: план тем и журнал производства ──────────────────────────
// Контракт с заводом (content_converter/auto/planhub.py): GET /api/factory/plan
// отдаёт тему дня по слоту, POST /api/factory/log принимает события заказа.
model PlanSlot {
  id    String @id @default(cuid())
  date  String // YYYY-MM-DD
  slot  String // make | carousel | trainer:male | trainer:female | avatar
  topic String @default("")
  facts String @default("")

  @@unique([date, slot])
}

model FactoryJob {
  jobId     String   @id
  date      String   @default("")
  slot      String   @default("")
  kind      String   @default("")
  character String   @default("")
  topic     String   @default("")
  script    String   @default("")
  event     String   @default("") // создан | готов | опубликован | не принят | ошибка
  links     String   @default("[]")
  error     String   @default("")
  onDemand  Boolean  @default(false)
  cost      Float    @default(0) // смета заказа в долларах (событие «готов»)
  seconds   Int      @default(0) // длительность производства (событие «готов»)
  at        DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Брак, поставленный из Postos постфактум (кнопка в журнале). Отдельная
// таблица с монотонным id — завод забирает новые пометки курсором
// GET /api/factory/defects?after=<id>. Брак из бота сюда НЕ пишется
// (он приходит событием через /api/factory/log), иначе завод получит
// свои же пометки обратно.
model FactoryDefect {
  id      Int      @id @default(autoincrement())
  jobId   String
  comment String   @default("")
  at      DateTime @default(now())
}

// Нейро-аналитика контента: сохранённые разборы «что заходит / что не
// заходит» по срезу (платформа|проект|профиль|период). Храним, чтобы не
// звать модель при каждом открытии страницы.
model SocialInsight {
  scope     String   @id
  result    String   @default("{}")
  updatedAt DateTime @updatedAt
}

// Заявка на доступ из Телеграма: сотрудник написал боту /start, ждёт
// одобрения владельца. Одобрить может только владелец — из бота или из
// раздела «Сотрудники».
model TgSignup {
  id        String   @id @default(cuid())
  chatId    String   @unique
  username  String?
  name      String?
  status    String   @default("pending")
  createdAt DateTime @default(now())
}

// Что уже перезалито из Instagram на другие площадки — чтобы не публиковать
// один и тот же ролик дважды. Пишет завод после успешной публикации.
model MirrorLog {
  id        Int      @id @default(autoincrement())
  platform  String
  permalink String
  link      String   @default("")
  at        DateTime @default(now())

  @@unique([platform, permalink])
}

// Маршруты публикации: что и куда уходит. Источник правды для завода и
// зеркалирования — выключенное не публикуется ни автопланом, ни кнопкой.
// kind="*" — рубильник площадки целиком.
model RouteFlag {
  id       Int      @id @default(autoincrement())
  platform String
  kind     String
  enabled  Boolean  @default(true)
  at       DateTime @updatedAt

  @@unique([platform, kind])
}
